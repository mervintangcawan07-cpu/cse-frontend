model ReconciliationRecord {
  id                   String               @id @default(cuid())
  sourceType           String               // PAYMONGO_CHECKOUT, PAYMONGO_PAYMENT, INTERNAL_TRANSACTION, REFERRAL_REWARD, PARTNER_COMMISSION, PAYOUT
