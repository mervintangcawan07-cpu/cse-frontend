model BackupPayload {
  filename  String   @id
  payload   String   @db.Text
  createdAt DateTime @default(now())
}

enum StudyPostTopic {
  QUESTION_HELP
  EXAM_INTEL
  MINDSET_VENT
  STUDY_HACKS
}

enum StudyReactionType {
  GOT_IT
  SAME_STRUGGLE
  HIGH_YIELD
  KEEP_PUSHING
}

model StudyPost {
  id             String         @id @default(cuid())
  authorId       String
  topic          StudyPostTopic @default(QUESTION_HELP)
  title          String?
  content        String         @db.Text
  hasSpoiler     Boolean        @default(false)
  spoilerContent String?        @db.Text
  isAnonymous    Boolean        @default(false)
  isPinned       Boolean        @default(false)
  pinnedAt       DateTime?
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

