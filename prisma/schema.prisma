datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                       String    @id @default(cuid())
  name                     String?
  email                    String    @unique
  password                 String
  role                     Role      @default(USER)
  isPaid                   Boolean   @default(false)
  paidUntil                DateTime? // Real-world expiration date (null = Lifetime)
  planType                 String? // "1_MONTH" | "6_MONTHS" | "1_YEAR" | "LIFETIME"

  // 🔒 Security, Moderation & Active Session Fields
  isBanned                 Boolean   @default(false)
  banReason                String?
  isEmailVerified          Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  passwordResetToken       String?   @unique
  passwordResetExpires     DateTime?
  activeSessionId          String? // Single active session ID
  lastActiveAt             DateTime? // Timestamp for 30-min inactivity check

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Database Relations
  results      ExamResult[]
  streak       UserStreak?
  bookmarks    Bookmark[]
  examDraft    ExamDraft?
  transactions Transaction[]

  @@index([email])
  @@index([role])
}

model ExamResult {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score      Float
  totalItems Int
  correct    Int
  incorrect  Int
  skipped    Int
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Question {
  id          String   @id @default(cuid())
  category    String   // e.g., "Verbal Ability", "Numerical Reasoning", "Analytical Reasoning", "General Information"
  subtopic    String   @default("General") // e.g., "Vocabulary", "Grammar", "Word Problems", "Philippine Constitution"
  prompt      String   @db.Text
  
  // Choice representation supporting both formats for maximum compatibility
  options     String[] // Array format: ["Option A", "Option B", "Option C", "Option D"]
  optionA     String?  
  optionB     String?  
  optionC     String?  
  optionD     String?  

  answerIndex Int      // Index of the correct option (0, 1, 2, or 3)
  explanation String?  @db.Text // Explanation for answer review
  imageUrl    String?  // Image URLs for charts, diagrams & graphs

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([subtopic])
  @@index([category, subtopic])
}

model ReadingMaterial {
  id        String   @id @default(cuid())
  title     String
  category  String
  content   String   @db.Text
  isPremium Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model StudyNote {
  id        String   @id @default(cuid())
  category  String
  title     String
  summary   String   @db.Text
  content   String[] // Bullet points or rules
  tips      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model Handbook {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String
  pages       String
  lastUpdated String   @default("Official Ref")
  fileData    String   @db.Text // Base64 encoded document
  fileName    String   @default("document.pdf")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model PricingPlan {
  id           String   @id @default(cuid())
  planType     String   @unique // "1_MONTH" | "6_MONTHS" | "1_YEAR" | "LIFETIME"
  name         String
  price        Int      // Stored in PHP (e.g. 99, 199, 299)
  durationDays Int      // 30, 180, 365, 0 for Lifetime
  updatedAt    DateTime @updatedAt
}

// ==========================================
// ENTERPRISE & INTERNAL ADMIN EXTENSIONS
// ==========================================

model UserStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String   // "QUESTION" | "HANDBOOK" | "STUDY_NOTE"
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

model ExamDraft {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String   @default("All")
  answersJson   String   @db.Text
  questionsJson String   @db.Text
  currentIndex  Int      @default(0)
  timeLeft      Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?  // null = System Broadcast
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // "INFO" | "PAYMENT" | "SYSTEM" | "STREAK"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Transaction {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkoutSessionId String   @unique
  paymentIntentId   String?
  amount            Int
  planType          String
  status            String   // "PENDING" | "PAID" | "FAILED"
  receiptUrl        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Flashcard {
  id        String   @id @default(cuid())
  category  String
  topic     String
  front     String   @db.Text
  back      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, topic])
}

enum DuelStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

model DuelMatch {
  id          String     @id @default(cuid())
  player1Id   String
  player1Name String     @default("Examinee 1")
  player2Id   String?
  player2Name String?
  status      DuelStatus @default(WAITING)
  questions   Json       // 5 rapid questions
  p1Score     Int        @default(0)
  p2Score     Int        @default(0)
  p1Current   Int        @default(0)
  p2Current   Int        @default(0)
  winnerId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ipAddress String?
  userAgent String?
  status    String   // "SUCCESS" | "FAILED"
  reason    String?  // e.g. "Invalid Password", "Account Banned"
  createdAt DateTime @default(now())

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String
  subject    String
  message    String   @db.Text
  status     String   @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED"
  adminNotes String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userEmail])
  @@index([status])
}