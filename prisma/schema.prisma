datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String?
  password  String
  role      Role         @default(USER)
  isPaid    Boolean      @default(false)
  paidUntil DateTime?    // Real-world expiration date (null = Lifetime)
  planType  String?      // "1_MONTH" | "6_MONTHS" | "LIFETIME"
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  results   ExamResult[]
}

model ExamResult {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score      Float
  totalItems Int
  correct    Int
  incorrect  Int
  skipped    Int
  createdAt  DateTime @default(now())
}

model Question {
  id          String   @id @default(cuid())
  category    String   // e.g., "Numerical", "Verbal", "Analytical", "General Info"
  prompt      String
  options     String[] // Array of choices: ["Option A", "Option B", "Option C", "Option D"]
  answerIndex Int      // Index of the correct option (0, 1, 2, or 3)
  explanation String?  // Optional explanation for the answer
  createdAt   DateTime @default(now())
}

model ReadingMaterial {
  id        String   @id @default(cuid())
  title     String
  category  String
  content   String
  isPremium Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudyNote {
  id        String   @id @default(cuid())
  category  String
  title     String
  summary   String
  content   String[] // Bullet points or rules
  tips      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Handbook {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String
  pages       String
  lastUpdated String   @default("Official Ref")
  fileData    String   @db.Text // Base64 encoded document
  fileName    String   @default("document.pdf")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PricingPlan {
  id           String   @id @default(cuid())
  planType     String   @unique // "1_MONTH" | "6_MONTHS" | "LIFETIME"
  name         String
  price        Int      // Stored in PHP (e.g. 199, 299, 499)
  durationDays Int      // 30, 180, 0 for Lifetime
  updatedAt    DateTime @updatedAt
}