  comments       StudyPostComment[]
  reactions      StudyPostReaction[]

  @@index([authorId])
  @@index([topic])
  @@index([isPinned])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
}

model StudyPostComment {
  id          String    @id @default(cuid())
  postId      String
  authorId    String
  content     String    @db.Text
  isAnonymous Boolean   @default(false)
  isAccepted  Boolean   @default(false)

