datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum ClassmateStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  BLOCKED
}

enum MessageState {
  SENT
  DELIVERED
  READ
}

enum RoomState {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum RoomParticipantRole {
  HOST
  MODERATOR
  MEMBER
}

enum EventRSVPStatus {
  ATTENDING
  MAYBE
  DECLINED
}

enum ClubMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String    @unique
  password  String
  role      Role      @default(USER)
  isPaid    Boolean   @default(false)
  paidUntil DateTime?
  planType  String?

  isBanned                 Boolean   @default(false)
  banReason                String?
  isEmailVerified          Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  passwordResetToken       String?   @unique
  passwordResetExpires     DateTime?
  activeSessionId          String?
  lastActiveAt             DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  results               ExamResult[]
  streak                UserStreak?
  bookmarks             Bookmark[]
  examDraft             ExamDraft?
  transactions          Transaction[]
  mistakes              UserMistake[]
  dailyQuestionAttempts DailyQuestionAttempt[]
  questionFlags         QuestionFlag[]
  badges                UserBadge[]

  // Classmate Relations
  sentClassmateRequests     ClassmateRelation[] @relation("SentClassmateRequests")
  receivedClassmateRequests ClassmateRelation[] @relation("ReceivedClassmateRequests")

  // Messaging Relations
  directMessageParticipants DirectMessageParticipant[]
  sentDirectMessages        DirectMessage[]

  // Study Room Relations
  hostedRooms      StudyRoom[]            @relation("HostedStudyRooms")
  roomParticipants StudyRoomParticipant[]
  roomMessages     StudyRoomMessage[]

  // Study Event & Club Relations
  hostedEvents    StudyEvent[]      @relation("HostedEvents")
  eventRSVPs      StudyEventRSVP[]
  ownedClubs      StudyClub[]       @relation("OwnedClubs")
  clubMemberships StudyClubMember[]

  // Study Together Profile (Separate from main authentication/account)
  studyProfile StudyTogetherProfile?

  // Study Commons Relations
  studyPosts         StudyPost[]         @relation("UserStudyPosts")
  studyPostComments  StudyPostComment[]  @relation("UserStudyPostComments")
  studyPostReactions StudyPostReaction[] @relation("UserStudyPostReactions")

  // Referral System Relations
  referralCode        ReferralCode?
  referredAttribution ReferralAttribution?  @relation("ReferredAttribution")
  inviterAttributions ReferralAttribution[] @relation("InviterAttributions")
  invitedReferrals    Referral[]            @relation("InvitedReferrals")
  receivedReferral    Referral?             @relation("ReceivedReferral")
  earnedRewards       ReferralReward[]      @relation("EarnedRewards")
  generatedRewards    ReferralReward[]      @relation("GeneratedRewards")
  payouts             ReferralPayout[]      @relation("UserPayouts")

  @@index([email])
  @@index([role])
  @@index([deletedAt])
}

model StudyTogetherProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  displayName      String
  avatar           String?
  ageRange         String?
  gender           String?
  bio              String?  @db.VarChar(160)
  studyGoal        String?
  studyInterests   String[] @default([])
  experienceLevel  String?
  studyPreferences String[] @default([])
  availability     String[] @default([])
  language         String?  @default("English")
  profileCompleted Boolean  @default(false)

  // Privacy & Visibility Controls (User controls what other study partners can see)
  showAgeRange     Boolean @default(false)
  showGender       Boolean @default(false)
  showBio          Boolean @default(true)
  showStudyGoal    Boolean @default(true)
  showInterests    Boolean @default(true)
  showPreferences  Boolean @default(true)
  showAvailability Boolean @default(true)
  showActivity     Boolean @default(true)

  // Presence & Study Availability
  presenceStatus    String? @default("ONLINE") // "ONLINE" | "AWAY" | "BUSY" | "OFFLINE"
  customStatusText  String? @db.VarChar(60) // e.g. "Reviewing Math", "Open for Duels"
  customStatusEmoji String? @db.VarChar(10) // e.g. "📖", "☕", "🎯"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([profileCompleted])
}

model ClassmateRelation {
  id         String          @id @default(cuid())
  senderId   String
  receiverId String
  status     ClassmateStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  sender   User @relation("SentClassmateRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedClassmateRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId, status])
  @@index([receiverId, status])
  @@index([status])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants DirectMessageParticipant[]
  messages     DirectMessage[]

  @@index([updatedAt(sort: Desc)])
}

model DirectMessageParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String       @db.Text
  state          MessageState @default(SENT)
  replyToId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      DirectMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      DirectMessage[] @relation("MessageReplies")

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([conversationId, state])
  @@index([senderId])
  @@index([createdAt])
  @@index([replyToId])
}

model StudyRoom {
  id                     String    @id @default(cuid())
  name                   String
  description            String?   @db.Text
  topic                  String    @default("General Review")
  isPublic               Boolean   @default(true)
  maxParticipants        Int       @default(10)
  inviteCode             String    @unique
  scheduledFor           DateTime?
  state                  RoomState @default(ACTIVE)
  hostId                 String
  // Room Permissions & Policy Controls
  allowMemberWhiteboard  Boolean   @default(true)
  allowMemberScreenShare Boolean   @default(true)
  allowMemberChat        Boolean   @default(true)
  isLocked               Boolean   @default(false)
  // Active Study Topic (Question Bank or Host Uploaded Image)
  activeTopicType        String? // "QUESTION" | "IMAGE" | null
  activeQuestionId       String?
  activeTopicImage       String?   @db.Text
  activeTopicMeta        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host           User                   @relation("HostedStudyRooms", fields: [hostId], references: [id], onDelete: Cascade)
  activeQuestion Question?              @relation(fields: [activeQuestionId], references: [id], onDelete: SetNull)
  participants   StudyRoomParticipant[]
  messages       StudyRoomMessage[]

  @@index([hostId])
  @@index([state])
  @@index([isPublic])
  @@index([inviteCode])
  @@index([activeQuestionId])
}

model StudyRoomParticipant {
  id       String              @id @default(cuid())
  roomId   String
  userId   String
  role     RoomParticipantRole @default(MEMBER)
  isMuted  Boolean             @default(false)
  canDraw  Boolean             @default(true)
  canShare Boolean             @default(true)
  joinedAt DateTime            @default(now())

  room StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model StudyRoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room   StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt(sort: Asc)])
  @@index([senderId])
  @@index([createdAt])
}

model StudyEvent {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  topic       String   @default("General Review")
  scheduledAt DateTime
  durationMin Int      @default(60)
  isPublic    Boolean  @default(true)
  hostId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  host  User             @relation("HostedEvents", fields: [hostId], references: [id], onDelete: Cascade)
  rsvps StudyEventRSVP[]

  @@index([hostId])
  @@index([scheduledAt])
  @@index([isPublic])
}

model StudyEventRSVP {
  id        String          @id @default(cuid())
  eventId   String
  userId    String
  status    EventRSVPStatus @default(ATTENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  event StudyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model StudyClub {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  category    String   @default("General Study")
  isPublic    Boolean  @default(true)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User              @relation("OwnedClubs", fields: [ownerId], references: [id], onDelete: Cascade)
  members StudyClubMember[]

  @@index([ownerId])
  @@index([category])
  @@index([isPublic])
}

model StudyClubMember {
  id       String         @id @default(cuid())
  clubId   String
  userId   String
  role     ClubMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  club StudyClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model ExamResult {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  score      Float
  totalItems Int
  correct    Int
  incorrect  Int
  skipped    Int

  timeSpentSec Int     @default(0)
  examType     String  @default("FULL_MOCK")
  passed       Boolean @default(false)

  detailsJson String?  @db.Text
  createdAt   DateTime @default(now())

  categoryBreakdowns ExamCategoryResult[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([examType])
}

model ExamCategoryResult {
  id           String     @id @default(cuid())
  examResultId String
  examResult   ExamResult @relation(fields: [examResultId], references: [id], onDelete: Cascade)

  category     String
  totalItems   Int    @default(0)
  correct      Int    @default(0)
  incorrect    Int    @default(0)
  accuracy     Float  @default(0.0)
  timeSpentSec Int    @default(0)

  createdAt DateTime @default(now())

  @@index([examResultId, category])
  @@index([category])
}

model Question {
  id       String @id @default(cuid())
  category String
  subtopic String @default("General")
  prompt   String @db.Text

  options String[]
  optionA String?
  optionB String?
  optionC String?
  optionD String?

  answerIndex Int
  explanation String? @db.Text
  imageUrl    String?

  // --- Premium Educational & Reasoning Fields ---
  stepByStep          String?  @db.Text
  whyA                String?  @db.Text
  whyB                String?  @db.Text
  whyC                String?  @db.Text
  whyD                String?  @db.Text
  eliminationStrategy String?  @db.Text
  commonTrap          String?  @db.Text
  examTip             String?  @db.Text
  difficulty          String?  @default("MEDIUM")
  tags                String[] @default([])
  skillTested         String?

  userMistakes          UserMistake[]
  dailyQuestionAttempts DailyQuestionAttempt[]
  flags                 QuestionFlag[]
  activeInStudyRooms    StudyRoom[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  @@index([category, subtopic])
  @@index([subtopic])
  @@index([difficulty])
  @@index([deletedAt])
}

model DailyQuestionAttempt {
  id         String   @id @default(cuid())
  userId     String
  dateString String
  questionId String
  userAnswer Int
  isCorrect  Boolean
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, dateString])
  @@index([dateString])
  @@index([questionId])
}

model QuestionFlag {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  reason     String
  notes      String?  @db.Text
  status     String   @default("PENDING") // PENDING | DISMISSED | RESOLVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([status])
  @@index([questionId])
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model UserMistake {
  id             String    @id @default(cuid())
  userId         String
  questionId     String
  userAnswer     Int?
  incorrectCount Int       @default(1)
  correctCount   Int       @default(0)
  lastAttemptAt  DateTime  @default(now())
  isMastered     Boolean   @default(false)
  masteredAt     DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, isMastered])
  @@index([userId, lastAttemptAt(sort: Desc)])
  @@index([questionId])
}

model ReadingMaterial {
  id        String   @id @default(cuid())
  title     String
  category  String
  content   String   @db.Text
  isPremium Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model StudyNote {
  id        String   @id @default(cuid())
  category  String
  title     String
  summary   String   @db.Text
  content   String[]
  tips      String?  @db.Text
  videoUrl  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model Handbook {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String
  pages       String
  lastUpdated String   @default("Official Ref")
  fileData    String   @db.Text
  fileName    String   @default("document.pdf")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model PricingPlan {
  id           String   @id @default(cuid())
  planType     String   @unique
  name         String
  price        Int
  durationDays Int
  updatedAt    DateTime @updatedAt
}

model UserStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

model ExamDraft {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String   @default("All")
  answersJson   String   @db.Text
  questionsJson String   @db.Text
  currentIndex  Int      @default(0)
  timeLeft      Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String   @db.Text
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@index([isRead])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Transaction {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkoutSessionId      String   @unique
  paymentIntentId        String?
  amount                 Int      // amount in pesos or centavos as stored
  grossAmountCentavos    Int?     // authoritative gross list price in centavos
  discountAmountCentavos Int?     @default(0) // discount applied in centavos
  feeAmountCentavos      Int?     @default(0) // PayMongo processing fee in centavos
  netSettlementCentavos  Int?     // net proceeds received in centavos
  planType               String
  status                 String
  receiptUrl             String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  referralReward    ReferralReward?
  partnerCommission PartnerCommission?
  ledgerEntries     FinancialLedgerEntry[]
  taxRecords        TaxRecord[]

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model Flashcard {
  id          String    @id @default(cuid())
  category    String
  topic       String    @default("General")
  front       String?   @db.Text
  back        String?   @db.Text
  question    String?   @db.Text
  answer      String?   @db.Text
  options     String[]  @default([])
  explanation String?   @db.Text
  difficulty  String    @default("medium")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  @@index([category, topic])
  @@index([deletedAt])
}

enum DuelStatus {
  WAITING
  WAITING_FOR_ACCEPT
  DECLINED
  IN_PROGRESS
  FINISHED
}

model DuelMatch {
  id               String     @id @default(cuid())
  player1Id        String
  player1Name      String     @default("Examinee 1")
  player2Id        String?
  player2Name      String?
  challengedUserId String?
  status           DuelStatus @default(WAITING)
  questions        Json
  p1Score          Int        @default(0)
  p2Score          Int        @default(0)
  p1Current        Int        @default(0)
  p2Current        Int        @default(0)
  winnerId         String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([player1Id])
  @@index([challengedUserId])
}

model SystemSetting {
  key       String    @id
  value     String    @db.Text
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ipAddress String?
  userAgent String?
  status    String
  reason    String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String
  subject    String
  message    String   @db.Text
  status     String   @default("OPEN")
  adminNotes String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userEmail])
  @@index([status])
}

model SyncStatus {
  id             String   @id @default("csc_sync_status")
  lastSyncAt     DateTime @default(now())
  nextSyncAt     DateTime
  status         String   @default("IDLE")
  recordsUpdated Int      @default(0)
  lastError      String?  @db.Text
  updatedAt      DateTime @updatedAt
}

model SyncLog {
  id        String   @id @default(cuid())
  sourceUrl String
  action    String
  details   String   @db.Text
  isError   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model CSCExamSchedule {
  id               String    @id @default(cuid())
  title            String
  examDate         DateTime
  appOpeningDate   DateTime?
  appClosingDate   DateTime?
  status           String    @default("UPCOMING")
  isPinned         Boolean   @default(false)
  isManualOverride Boolean   @default(false)
  notes            String?   @db.Text
  officialLink     String?
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())

  @@index([examDate])
  @@index([status])
}

model CSCAnnouncement {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  category    String   @default("GENERAL")
  publishedAt DateTime @default(now())
  sourceUrl   String?
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([publishedAt(sort: Desc)])
}

model CSCDownload {
  id        String   @id @default(cuid())
  title     String
  category  String
  fileUrl   String
  fileSize  String?
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ==========================================
// DISASTER RECOVERY & BACKUP SYSTEM MODELS
// ==========================================

enum BackupType {
  DAILY
  MANUAL
  PRE_RESTORE_EMERGENCY
  WEEKLY
  MONTHLY
}

enum BackupStatus {
  PENDING
  RUNNING
  COMPLETED
  VERIFYING
  VERIFIED
  FAILED
  VERIFICATION_FAILED
  RESTORE_PENDING
  RESTORING
  RESTORED
  RESTORE_FAILED
}

enum BackupVerificationStatus {
  UNVERIFIED
  PASSED
  FAILED
  SKIPPED
}

model Backup {
  id                  String                   @id @default(cuid())
  backupType          BackupType               @default(MANUAL)
  status              BackupStatus             @default(PENDING)
  filename            String
  storageKey          String
  storageProvider     String                   @default("s3")
  sizeBytes           BigInt                   @default(0)
  checksum            String?
  databaseVersion     String?                  @default("PostgreSQL")
  schemaVersion       String?                  @default("1.0.0")
  verificationStatus  BackupVerificationStatus @default(UNVERIFIED)
  verificationMessage String?                  @db.Text
  verifiedAt          DateTime?
  triggeredBy         String?                  @default("SYSTEM")
  errorMessage        String?                  @db.Text
  expiresAt           DateTime?
  protected           Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  completedAt         DateTime?
  restoredAt          DateTime?

  auditLogs BackupAuditLog[]

  @@index([status])
  @@index([backupType])
  @@index([createdAt(sort: Desc)])
  @@index([verificationStatus])
}

model BackupAuditLog {
  id         String   @id @default(cuid())
  backupId   String?
  backup     Backup?  @relation(fields: [backupId], references: [id], onDelete: Cascade)
  actorId    String?
  actorEmail String?
  action     String
  status     String   @default("SUCCESS")
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([backupId])
  @@index([createdAt(sort: Desc)])
  @@index([action])
